.statistics.text-center.pt-5.pb-5
  .container
    .shorten.position-relative
        form.d-flex.flex-column.flex-lg-row
          input.form-control.me-2.mb-2.mb-lg-0(type='text' placeholder='Shorten a link here...' aria-label='Search')
          .invalid-feedback.position-absolute hhh 
          button.btn.custom-button(type='submit') Shorten it!
        ul.links.list-unstyled
          li.d-flex.flex-column.flex-lg-row.mt-5.mb-5.p-3.bg-white.align-items-lg-center
              p.long-link.w-100.mb-0 https://www.frontendmentor.io
              hr.divider(role='separator')      
              p.short-link.mb-0.me-2 https:rel.link/k4lkyk
              button.btn.custom-button(type='button') Copy
          li.flex-column.flex-lg-row.d-flex.mt-5.mb-5.p-3.bg-white.align-items-lg-center
              p.long-link.w-100.mb-0 https://www.frontendmentor.io
              hr.divider(role='separator')      
              p.short-link.mb-0.me-2 https:rel.link/k4lkyk
              button.btn.custom-button(type='button') Copy
    h2 Advanced Statistics 
    p Track how your link are performing across the web with our advanced statistics dashboard.
    .row.position-relative.justify-content-between.mt-5
      .card.position-relative.col-lg-3.p-4
        span.position-absolute.rounded-circle
          img(src='images/icon-brand-recognition.svg' alt='...')
        .card-body
          h5.card-title Brand Recognition
          p.card-text
            Boost your brand recognition with each click.Generic links don't mean a thing.Branded links help instil confidence in your content
      
      .card.position-relative.col-lg-3.p-4
        span.position-absolute.rounded-circle
          img(src='images/icon-detailed-records.svg' alt='...')
        .card-body
          h5.card-title Detailed Records 
          p.card-text Gain insights into who is clicking your links.Knowing when and where people engage whit your content helps inform better decisions
      
      .card.position-relative.col-lg-3.p-4
        span.position-absolute.rounded-circle
          img(src='images/icon-fully-customizable.svg' alt='...')
        .card-body
          h5.card-title Fully Customizable
          p.card-text improve brand awareness and content discoverability through customizable links, supercharging audience engagement
          
      